# === Twilio ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Публичный URL voice-сервиса (для вебхуков Twilio)
VOICE_PUBLIC_URL=http://voice-service:8081

# === TTS ===
# 'twilio' — встроенный <Say>, 'yandex' — SpeechKit, 'none' — только готовые файлы
TTS_PROVIDER=twilio

YANDEX_TTS_API_KEY=
YANDEX_TTS_FOLDER_ID=

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# === БД voice-сервиса ===
VOICE_DB_URL=sqlite:///data/voice.db

# === Логика ===
VOICE_ESCALATION_MINUTES=15
QUIET_HOURS_START=22
QUIET_HOURS_END=7
VOICE_MAX_ATTEMPTS=3
VOICE_CALL_TIMEOUT=30

# Тестовый номер (если задан — все звонки идут только на него)
VOICE_TEST_NUMBER=

# === API ===
VOICE_API_KEY=change-me-in-production

# === Окружение ===
ENV=development
LOG_LEVEL=INFO