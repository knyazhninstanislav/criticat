# Обязательно в production
ENV=production
JWT_SECRET=<длинная случайная строка ≥ 32 байта>
JWT_ACCESS_TTL_MINUTES=5
JWT_REFRESH_TTL_DAYS=30

# Pepper'ы (рекомендуется)
PASSWORD_PEPPER=<случайная строка>
REFRESH_PEPPER=<случайная строка>

# Хранение revoked-сессий
REVOKED_SESSION_KEEP_DAYS=7

# Timezone
TZ=Asia/Novosibirsk

# API
API_KEY=your_secret_api_key
LOG_LEVEL=INFO

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Настройки очередей (в миллисекундах)
MESSAGE_TTL=60000      # 1 минута - время жизни сообщения в очереди
RETRY_DELAY=300000     # 5 минут - задержка перед повторной отправкой
MAX_RETRIES=3          # Максимальное количество попыток
PENDING_TIMEOUT_HOURS=24 # Время ожидания подтверждения от пользователя

# === Voice Service ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Публичный URL voice-сервиса
# В проде — https://voice.criticat.example.com
# В деве — ngrok URL, например: https://abc123.ngrok.io
VOICE_PUBLIC_URL=https://your-public-url

TTS_PROVIDER=twilio

YANDEX_TTS_API_KEY=
YANDEX_TTS_FOLDER_ID=

# Через сколько минут запускать обзвон
VOICE_ESCALATION_MINUTES=15

# Включена ли эскалация
VOICE_ESCALATION_ENABLED=true

# Тихие часы
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# Максимум попыток дозвона
VOICE_MAX_ATTEMPTS=3
VOICE_CALL_TIMEOUT=30

# Тестовый номер (все звонки идут только на него)
VOICE_TEST_NUMBER=+79001234567

# API-ключ для ручного триггера звонка
VOICE_API_KEY=change-me-in-production
